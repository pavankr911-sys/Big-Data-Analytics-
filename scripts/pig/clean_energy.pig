-- ==============================================================================
-- BCS714D Big Data Analytics - Theme 3: Apache Pig Data Transformation Script
-- Script: clean_energy.pig
-- Purpose: Load raw structured OWID dataset, filter header & invalid records,
--          project core analytical attributes, preserving NULLs for unobserved values.
-- ==============================================================================

-- Load energy dataset with schema definition
raw_energy = LOAD '$INPUT' USING PigStorage(',') AS (
    country:chararray,
    year:int,
    iso_code:chararray,
    population:double,
    gdp:double,
    bioenergy_electricity_per_capita_kwh:chararray,
    bioenergy_electricity_share_pct:chararray,
    bioenergy_electricity_twh:chararray,
    biofuels_energy_annual_change_pct:chararray,
    biofuels_energy_per_capita_kwh:chararray,
    biofuels_energy_share_pct:chararray,
    biofuels_energy_twh:chararray,
    carbon_intensity_elec:chararray,
    coal_cons_per_capita_kwh:chararray,
    coal_electricity_per_capita_kwh:chararray,
    coal_electricity_share_pct:chararray,
    coal_electricity_twh:chararray,
    coal_energy_per_capita_kwh:chararray,
    coal_energy_share_pct:chararray,
    coal_energy_twh:chararray,
    coal_prod_per_capita_kwh:chararray,
    coal_production_twh:chararray,
    electricity_carbon_intensity_gco2eq_per_kwh:double,
    electricity_demand_per_capita_kwh:chararray,
    electricity_demand_twh:chararray,
    electricity_generation_per_capita_kwh:chararray,
    electricity_generation_twh:chararray,
    electricity_share_energy_pct:chararray,
    energy_cons_change_pct:chararray,
    energy_cons_change_twh:chararray,
    energy_per_capita_kwh:chararray,
    energy_per_gdp_kwh:chararray,
    fossil_cons_per_capita_kwh:chararray,
    fossil_electricity_per_capita_kwh:chararray,
    fossil_electricity_share_pct:chararray,
    fossil_electricity_twh:chararray,
    fossil_energy_per_capita_kwh:chararray,
    fossil_energy_share_pct:chararray,
    fossil_energy_twh:chararray,
    fossil_fuel_consumption_twh:chararray,
    fossil_share_elec:chararray,
    fossil_share_energy:chararray,
    gas_cons_per_capita_kwh:chararray,
    gas_electricity_per_capita_kwh:chararray,
    gas_electricity_share_pct:chararray,
    gas_electricity_twh:chararray,
    gas_energy_per_capita_kwh:chararray,
    gas_energy_share_pct:chararray,
    gas_energy_twh:chararray,
    gas_prod_per_capita_kwh:chararray,
    gas_production_twh:chararray,
    greenhouse_gas_emissions_twh:chararray,
    hydro_cons_per_capita_kwh:chararray,
    hydro_electricity_per_capita_kwh:chararray,
    hydro_electricity_share_pct:chararray,
    hydro_electricity_twh:chararray,
    hydro_energy_per_capita_kwh:chararray,
    hydro_energy_share_pct:chararray,
    hydro_energy_twh:chararray,
    low_carbon_cons_per_capita_kwh:chararray,
    low_carbon_electricity_per_capita_kwh:chararray,
    low_carbon_electricity_share_pct:chararray,
    low_carbon_electricity_twh:chararray,
    low_carbon_energy_per_capita_kwh:chararray,
    low_carbon_energy_share_pct:chararray,
    low_carbon_energy_twh:chararray,
    net_elec_imports_share_demand_pct:chararray,
    net_elec_imports_twh:chararray,
    nuclear_cons_per_capita_kwh:chararray,
    nuclear_electricity_per_capita_kwh:chararray,
    nuclear_electricity_share_pct:chararray,
    nuclear_electricity_twh:chararray,
    nuclear_energy_per_capita_kwh:chararray,
    nuclear_energy_share_pct:chararray,
    nuclear_energy_twh:chararray,
    oil_cons_per_capita_kwh:chararray,
    oil_electricity_per_capita_kwh:chararray,
    oil_electricity_share_pct:chararray,
    oil_electricity_twh:chararray,
    oil_energy_per_capita_kwh:chararray,
    oil_energy_share_pct:chararray,
    oil_energy_twh:chararray,
    oil_prod_per_capita_kwh:chararray,
    oil_production_twh:chararray,
    other_renewable_electricity_per_capita_kwh:chararray,
    other_renewable_electricity_share_pct:chararray,
    other_renewable_electricity_twh:chararray,
    other_renewable_energy_per_capita_kwh:chararray,
    other_renewable_energy_share_pct:chararray,
    other_renewable_energy_twh:chararray,
    other_renewables_cons_per_capita_kwh:chararray,
    other_renewables_energy_per_capita_kwh:chararray,
    other_renewables_energy_share_pct:chararray,
    other_renewables_energy_twh:chararray,
    per_capita_electricity_kwh:chararray,
    primary_energy_consumption_twh:chararray,
    renewables_cons_per_capita_kwh:chararray,
    renewables_electricity_per_capita_kwh:chararray,
    renewables_electricity_share_pct:chararray,
    renewables_electricity_twh:chararray,
    renewables_energy_per_capita_kwh:chararray,
    renewables_energy_share_pct:chararray,
    renewables_energy_twh:double,
    renewables_share_elec:chararray,
    renewables_share_energy:chararray,
    solar_cons_per_capita_kwh:chararray,
    solar_electricity_per_capita_kwh:chararray,
    solar_electricity_share_pct:chararray,
    solar_electricity_twh:double,
    solar_energy_per_capita_kwh:chararray,
    solar_energy_share_pct:chararray,
    solar_energy_twh:chararray,
    total_electricity_demand_twh:chararray,
    total_electricity_generation_twh:chararray,
    total_energy_per_capita_kwh:chararray,
    total_energy_per_gdp_kwh:chararray,
    total_energy_twh:double,
    wind_cons_per_capita_kwh:chararray,
    wind_electricity_per_capita_kwh:chararray,
    wind_electricity_share_pct:chararray,
    wind_electricity_twh:double,
    wind_energy_per_capita_kwh:chararray,
    wind_energy_share_pct:chararray,
    wind_energy_twh:chararray
);

-- 2. Filter records:
-- Exclude header row, enforce analysis period (2000-2024), and ensure non-null country and total energy
valid_records = FILTER raw_energy BY 
    country != 'country' AND
    country IS NOT NULL AND
    year >= 2000 AND year <= 2024 AND
    total_energy_twh IS NOT NULL;

-- 3. Project targeted schema
-- NOTE: Do NOT coerce missing numeric values to 0.0, as doing so distorts downstream SQL/Hive averages.
-- Missing indicators remain null so Hive AVG() functions correctly disregard unobserved values.
cleaned_records = FOREACH valid_records GENERATE
    country,
    year,
    (iso_code IS NOT NULL ? iso_code : '') AS iso_code,
    total_energy_twh,
    renewables_energy_twh,
    solar_electricity_twh,
    wind_electricity_twh,
    electricity_carbon_intensity_gco2eq_per_kwh AS carbon_intensity;

-- 4. Store cleaned and normalized dataset into HDFS for Hive Ingestion
STORE cleaned_records INTO '$OUTPUT' USING PigStorage(',');
